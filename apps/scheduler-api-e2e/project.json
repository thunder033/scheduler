{
  "name": "scheduler-api-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["scheduler-api"],
  "targets": {
    "e2e": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "dependsOn": ["scheduler-api:build", "scheduler-api:serve"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vitest run --config vitest.e2e.config.mts"
      }
    }
  }
}
