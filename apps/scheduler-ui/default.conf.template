# Rendered by the nginx image's envsubst entrypoint into conf.d/default.conf
# when the container starts; API_UPSTREAM is set at deploy time.
server {
    listen 8080;
    root /usr/share/nginx/html;

    # Resolve the upstream per request instead of once at startup, so nginx
    # starts without the API and follows it when it is recreated
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # The API serves everything under its /api global prefix, so the original
    # request path is forwarded unchanged
    location /api {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Fingerprinted build assets never change under the same name
    location ~* \.(?:js|css|woff2?|ico|svg|png|jpg|webp)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA: serve index.html for client-side routes and never cache it
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
