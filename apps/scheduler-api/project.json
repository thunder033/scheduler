{
  "name": "scheduler-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scheduler-api/src",
  "projectType": "application",
  "tags": [],
  "namedInputs": {
    "uiStyles": []
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands"
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "scheduler-api:build"
      }
    }
  }
}
