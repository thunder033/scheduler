{
  "name": "scheduler-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scheduler-api/src",
  "projectType": "application",
  "tags": [],
  "namedInputs": {
    "uiStyles": []
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "prune-lockfile": {
      "executor": "@nx/js:prune-lockfile",
      "cache": true,
      "dependsOn": ["build"],
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/package-lock.json"
      ],
      "outputs": [
        "{projectRoot}/dist/package.json",
        "{projectRoot}/dist/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "docker:build": {
      "dependsOn": ["build", "^build", "prune-lockfile"],
      "options": {
        "args": ["--tag scheduler-api"]
      }
    },
    "docker:run": {
      "options": {
        "command": "docker run {args} scheduler-api"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands"
    },
    "serve": {
      "executor": "@nx/js:node",
      "options": {
        "buildTarget": "scheduler-api:build"
      }
    }
  }
}
