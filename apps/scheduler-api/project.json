{
  "name": "scheduler-api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/scheduler-api/src",
  "projectType": "application",
  "tags": [],
  "namedInputs": {
    "sharedGlobals": []
  },
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "vite build"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^typecheck"],
      "inputs": [
        "default",
        "^default",
        { "externalDependencies": ["typescript"] }
      ],
      "options": {
        "cwd": "{projectRoot}",
        "commands": [
          "tsc -p tsconfig.app.json --noEmit",
          "tsc -p tsconfig.spec.json --noEmit"
        ],
        "parallel": false
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "scheduler-api:build",
        "runBuildTargetDependencies": false
      }
    }
  }
}
